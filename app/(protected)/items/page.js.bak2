'use client';

import { useState, useMemo, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { useUserAuth } from '@/context/UserContext';
import { useLang } from '@/hooks/useLang';
import { getSafeImageUrl, DEFAULT_IMG, deleteImageFromStorage }
  from '@/helpers/imageHelpers';

/* ══════════════════════════════════════════
   SAFE FIREBASE IMPORTS — 100% OFFLINE SAFE
══════════════════════════════════════════ */
let db = null;
let collection, query, where, onSnapshot, deleteDoc, doc;

try {
  const firebaseMod = require('@/lib/firebase');
  db = firebaseMod.db || null;
} catch (e) {
  console.warn('Firebase core offline:', e);
}

try {
  const firestore = require('firebase/firestore');
  collection = firestore.collection;
  query = firestore.query;
  where = firestore.where;
  onSnapshot = firestore.onSnapshot;
  deleteDoc = firestore.deleteDoc;
  doc = firestore.doc;
} catch (e) {
  console.warn('Firestore SDK offline:', e);
}

/* ══════════════════════════════════════════
   MAIN COMPONENT
══════════════════════════════════════════ */
export default function ItemsPage() {
  const { user } = useUserAuth();
  const router   = useRouter();
  const { lang } = useLang();

  const [items, setItems]           = useState([]);
  const [isLoading, setIsLoading]   = useState(true);
  const [searchQuery, setSearchQuery] = useState('');
  const [isOnline, setIsOnline]     = useState(
    typeof navigator !== 'undefined' ? navigator.onLine : true
  );

  /* ── Online/Offline Network Monitor ── */
  useEffect(() => {
    const handleOnline  = () => setIsOnline(true);
    const handleOffline = () => setIsOnline(false);
    window.addEventListener('online', handleOnline);
    window.addEventListener('offline', handleOffline);
    return () => {
      window.removeEventListener('online', handleOnline);
      window.removeEventListener('offline', handleOffline);
    };
  }, []);

  /* ── Firestore Listener with Strict Data Isolation ── */
  useEffect(() => {
    // ★ CRITICAL: Clear items when user changes — prevents cross-user data leakage
    setItems([]);
    setIsLoading(true);

    if (!user?.uid) {
      setIsLoading(false);
      return;
    }

    // If Firebase offline, skip listener (no crash)
    if (!db || !collection || !query || !where || !onSnapshot) {
      console.warn('Firestore offline — items listener skipped');
      setIsLoading(false);
      return;
    }

    let unsub = () => {};
    try {
      const q = query(
        collection(db, 'items'),
        where('uid', '==', user.uid)
      );

      unsub = onSnapshot(
        q,
        (snap) => {
          // ★ Double-check: only keep docs belonging to CURRENT user
          const userItems = snap.docs
            .map((d) => ({ id: d.id, ...d.data() }))
            .filter((d) => d.uid === user.uid);
          setItems(userItems);
          setIsLoading(false);
        },
        (err) => {
          console.warn('Items listener error:', err.message);
          setIsLoading(false);
        }
      );
    } catch (err) {
      console.warn('Failed to start items listener:', err.message);
      setIsLoading(false);
    }

    return () => {
      try { unsub(); } catch {}
    };
  }, [user?.uid]);

  /* ── Search Filtering ── */
  const filtered = useMemo(() => {
    if (!searchQuery.trim()) return items;
    const terms = searchQuery.trim().toLowerCase().split(/\s+/);
    return items.filter((item) => {
      const str = [
        item.name, item.sinhalaName, item.itemCode,
        item.barcode, item.brandName, item.categoryName,
      ].map((v) => (v || '').toLowerCase()).join(' ');
      return terms.every((t) => str.includes(t));
    });
  }, [items, searchQuery]);

  /* ── Delete Item with Ownership Check & Offline Guard ── */
  const handleDelete = async (item) => {
    if (!confirm('මකා දැමීම තහවුරු කරන්න?')) return;

    // ★ Ownership check — prevent deleting another user's item
    if (item.uid !== user?.uid) {
      alert('⛔ මෙම භාණ්ඩය ඔබගේ නොවේ. මකා දැමිය නොහැක.');
      return;
    }

    try {
      // Delete images from storage first (if any)
      const paths = Array.isArray(item.imagePaths) ? item.imagePaths : [];
      if (paths.length > 0) {
        await Promise.allSettled(paths.map((p) => deleteImageFromStorage(p)));
      }

      // Delete Firestore document (with offline guard)
      if (db && doc && deleteDoc) {
        await deleteDoc(doc(db, 'items', item.id));
      } else {
        alert('⚠️ Cloud offline — මකා දැමීම අතපසු විය. Internet සම්බන්ධ වූ පසු නැවත උත්සාහ කරන්න.');
      }
    } catch (e) {
      console.error('Delete error:', e);
      alert('Error: ' + e.message);
    }
  };

  /* ── Auth Guard ── */
  if (!user) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gray-100">
        <div className="bg-white p-8 rounded-2xl shadow-lg text-center max-w-sm">
          <div className="text-5xl mb-4">🔒</div>
          <h2 className="font-bold text-lg text-gray-800 mb-2">
            පරිශීලක සත්‍යාපනය අවශ්‍යයි
          </h2>
          <p className="text-gray-500 text-sm">
            භාණ්ඩ ලැයිස්තුව බැලීමට කරුණාකර Login වන්න.
          </p>
        </div>
      </div>
    );
  }

  /* ── Main Render ── */
  return (
    <div className="min-h-screen bg-gray-100">
      {/* Sticky Header */}
      <div className="bg-white p-4 shadow-sm sticky top-0 z-10 border-b">
        <div className="flex justify-between items-center mb-3">
          <div className="flex items-center gap-2 flex-wrap">
            <h1 className="text-xl font-bold">📦 භාණ්ඩ ලියාපදිංචිය</h1>
            <span
              className={`text-[10px] px-2 py-0.5 rounded-full font-bold ${
                isOnline
                  ? 'bg-green-100 text-green-700'
                  : 'bg-red-100 text-red-700'
              }`}
            >
              {isOnline ? '● Cloud' : '○ Offline'}
            </span>
          </div>
          <button
            onClick={() => router.push('/items/add')}
            className="bg-blue-600 text-white px-4 py-2 rounded-lg
                       font-bold hover:bg-blue-700"
          >
            ➕ නව+
          </button>
        </div>

        <input
          className="w-full p-3 border-2 rounded-xl
                     focus:border-blue-400 outline-none"
          placeholder="🔍 සොයන්න..."
          value={searchQuery}
          onChange={(e) => setSearchQuery(e.target.value)}
        />

        {/* User info bar */}
        <div className="mt-2 text-xs text-gray-500 flex items-center gap-2">
          <span>
            පරිශීලක: <strong className="text-gray-700">
              {user.email || user.displayName || user.uid}
            </strong>
          </span>
          <span className="text-gray-300">|</span>
          <span>
            මුළු භාණ්ඩ: <strong className="text-gray-700">{items.length}</strong>
          </span>
          {filtered.length !== items.length && (
            <>
              <span className="text-gray-300">|</span>
              <span>
                පෙනෙන: <strong className="text-blue-700">{filtered.length}</strong>
              </span>
            </>
          )}
        </div>
      </div>

      {/* Items List */}
      <div className="p-4 space-y-3">
        {isLoading ? (
          <div className="text-center py-10 text-gray-500">
            <div
              className="w-10 h-10 border-4 border-gray-200
                         border-t-blue-600 rounded-full
                         animate-spin mx-auto mb-3"
            />
            දත්ත ලබා ගනිමින්...
          </div>
        ) : filtered.length === 0 ? (
          <div className="text-center py-16 text-gray-500">
            <div className="text-5xl mb-3">📭</div>
            <p className="font-medium">
              {searchQuery
                ? `"${searchQuery}" සඳහා ප්‍රතිඵල නැත`
                : 'භාණ්ඩ නොමැත'}
            </p>
            {!searchQuery && (
              <button
                onClick={() => router.push('/items/add')}
                className="mt-4 bg-blue-600 text-white px-5 py-2
                           rounded-lg font-bold hover:bg-blue-700"
              >
                ➕ පළමු භාණ්ඩය එක් කරන්න
              </button>
            )}
          </div>
        ) : (
          filtered.map((item) => {
            const price    = parseFloat(item.sellingPriceRetail || 0);
            const stock    = parseFloat(item.stock || 0);
            const img      = getSafeImageUrl(item);
            const imgCount = item.images?.length || (item.picture ? 1 : 0);
            const isOut    = stock <= 0;
            const isLow    = stock > 0 && stock <= 5;

            return (
              <div
                key={item.id}
                className="bg-white p-4 rounded-xl shadow-sm flex gap-4
                           border hover:shadow-md transition-shadow"
              >
                {/* Image */}
                <div
                  className="w-20 h-20 bg-gray-100 rounded-lg
                             overflow-hidden border shrink-0 relative"
                >
                  <img
                    src={img}
                    className="w-full h-full object-cover"
                    onError={(e) => {
                      e.target.onerror = null;
                      e.target.src = DEFAULT_IMG;
                    }}
                    alt={item.name}
                  />
                  {imgCount > 1 && (
                    <div
                      className="absolute bottom-0 right-0 bg-black/60
                                 text-white text-xs px-1.5 py-0.5
                                 rounded-tl-lg font-bold"
                    >
                      +{imgCount - 1}
                    </div>
                  )}
                </div>

                {/* Info */}
                <div className="flex-1 min-w-0">
                  <h3 className="font-bold truncate text-gray-900 text-base">
                    {item.name}
                  </h3>
                  {item.sinhalaName && (
                    <div className="text-xs text-gray-500">
                      {item.sinhalaName}
                    </div>
                  )}
                  <div className="text-xs text-gray-400 mt-0.5">
                    {item.itemCode}
                    {item.barcode && ` • ${item.barcode}`}
                  </div>

                  {/* Badges */}
                  <div className="flex flex-wrap gap-1 mt-1.5">
                    {item.isHidden && (
                      <span
                        className="text-[10px] bg-red-100 text-red-700
                                   px-1.5 py-0.5 rounded font-bold"
                      >
                        🚫 Hidden
                      </span>
                    )}
                    {item.warrantyPeriod && (
                      <span
                        className="text-[10px] bg-amber-100 text-amber-700
                                   px-1.5 py-0.5 rounded font-bold"
                      >
                        🛡️ {item.warrantyPeriod}
                      </span>
                    )}
                    {item.brandName && (
                      <span
                        className="text-[10px] bg-indigo-100 text-indigo-700
                                   px-1.5 py-0.5 rounded font-bold"
                      >
                        🏷️ {item.brandName}
                      </span>
                    )}
                  </div>

                  {/* Price & Stock */}
                  <div className="mt-1.5 font-bold text-green-700">
                    Rs. {price.toFixed(2)}
                  </div>
                  <div
                    className={`text-xs font-bold ${
                      isOut
                        ? 'text-red-600'
                        : isLow
                        ? 'text-amber-600'
                        : 'text-gray-500'
                    }`}
                  >
                    {isOut
                      ? '🔴 නිම වී ඇත'
                      : isLow
                      ? `🟡 අඩු තොග: ${stock}`
                      : `🟢 තොග: ${stock}`}
                  </div>
                </div>

                {/* Action Buttons */}
                <div className="flex flex-col gap-2 justify-center">
                  <button
                    onClick={() => router.push(`/items/edit/${item.id}`)}
                    title="සංස්කරණය"
                    className="bg-blue-100 text-blue-700 px-3 py-2
                               rounded text-sm font-bold hover:bg-blue-200"
                  >
                    ✏️
                  </button>
                  <button
                    onClick={() => handleDelete(item)}
                    title="මකන්න"
                    className="bg-red-100 text-red-700 px-3 py-2
                               rounded text-sm font-bold hover:bg-red-200"
                  >
                    🗑️
                  </button>
                </div>
              </div>
            );
          })
        )}
      </div>
    </div>
  );
}