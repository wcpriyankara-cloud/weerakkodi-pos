{
  "name": "weerakkodi-pos",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
    "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron": "electron .",
    "electron:dev": "concurrently -k -p \"[{name}]\" -n \"NEXT,ELEC\" -c \"cyan.bold,green.bold\" \"npm run dev\" \"npx wait-on -i 2000 -t 300000 http-get://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dexie": "^3.2.7",
    "firebase": "^10.8.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.344.0",
    "next": "^14.2.28",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.weerakkodi.pos",
    "productName": "Weerakkodi POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "description": "Weerakkodi POS System",
  "author": "Weerakkodi"
}